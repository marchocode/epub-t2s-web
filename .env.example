# 复制为 .env 后按需修改: cp .env.example .env

TZ=Asia/Shanghai

# 站点对外访问地址（影响 canonical / og:url / sitemap）。
# 本地测试用默认值；发布后必须改成真实 HTTPS 域名，末尾不要带斜杠。
SITE_URL=http://127.0.0.1:8000

SITE_NAME=EPUB 繁转简
SITE_DESCRIPTION=免费在线将繁体中文 EPUB 电子书转换为简体中文，保留原排版与目录结构，转换完成后直接下载，文件不会被保存。
SITE_KEYWORDS=epub 繁转简,繁体转简体,epub 转换,电子书简繁转换,在线 epub 转换

# 是否允许搜索引擎收录 /stats 统计页（默认 0 = 不收录）
INDEX_STATS_PAGE=0

# 搜索引擎站长平台验证码（可选）
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=

# 仅在启用可选 caddy 服务时需要：你的域名（不含协议）
DOMAIN=
